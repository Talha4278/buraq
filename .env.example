# Google Places API Configuration for Live Reviews
# Obtain from Google Cloud Console: APIs & Services -> Credentials -> Create API Key
# Enable "Places API (New)" in Google Cloud Console
GOOGLE_PLACES_API_KEY=your_google_cloud_places_api_key_here

# (Optional) Direct Google Place ID for Buraq Dev.
# If omitted, /api/reviews will automatically resolve it by business name.
GOOGLE_PLACE_ID=
